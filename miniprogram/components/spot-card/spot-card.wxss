.spot-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s ease;
}

.spot-card:active {
  transform: scale(0.98);
}

.card-info {
  padding: 24rpx;
}

.spot-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2A;
}

.spot-region {
  max-width: 200rpx;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.trend-text {
  margin-top: 12rpx;
  line-height: 1.5;
  color: #888780;
}
