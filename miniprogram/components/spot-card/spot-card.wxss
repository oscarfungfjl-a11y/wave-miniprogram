/* ── 浪点卡片组件 v3 ── */

.spot-card {
  background: rgba(255,255,255,0.78);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border-radius: 56rpx;
  border: 1rpx solid rgba(255,255,255,0.6);
  box-shadow:
    0 8rpx 32rpx rgba(26,43,60,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.7);
  overflow: hidden;
  margin-bottom: 24rpx;
  transition: transform 0.2s ease;
}

.spot-card:active {
  transform: scale(0.98);
}

.card-info {
  padding: 28rpx;
}

.spot-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #1A2B3C;
}

.spot-region {
  max-width: 200rpx;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.trend-text {
  margin-top: 12rpx;
  line-height: 1.5;
  color: #8A9BAC;
}
