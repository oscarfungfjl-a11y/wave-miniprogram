/* ── 评分徽章组件 v3 ── */

.rating-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 高推荐/推荐 → teal */
.rating-excellent {
  background: rgba(29,158,117,0.12);
  color: #0F6E56;
}

/* 中推荐 → amber */
.rating-good {
  background: rgba(186,117,23,0.12);
  color: #854F0B;
}

/* 弱/不推荐 → gray */
.rating-fair {
  background: rgba(136,135,128,0.12);
  color: #5F5E5A;
}

.rating-poor {
  background: rgba(136,135,128,0.12);
  color: #5F5E5A;
}

.rating-score {
  font-size: 28rpx;
}

.rating-label {
  font-size: 20rpx;
  opacity: 0.9;
}
