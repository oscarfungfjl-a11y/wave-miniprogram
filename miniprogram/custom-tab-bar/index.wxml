<view class="tab-bar">
  <view
    class="tab-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <t-icon
      name="{{item.icon}}"
      size="44rpx"
      color="{{selected === index ? '#0F6E56' : '#888780'}}"
    />
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
