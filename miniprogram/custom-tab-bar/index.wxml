<view class="tab-bar">
  <view
    class="tab-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <t-icon
      name="{{item.icon}}"
      size="48rpx"
      color="{{selected === index ? '#378ADD' : '#9A9BAC'}}"
    />
    <view class="tab-dot" wx:if="{{selected === index}}"></view>
  </view>
</view>
