.tab-bar {
  position: fixed;
  bottom: 0;
  bottom: calc(0rpx + constant(safe-area-inset-bottom));
  bottom: calc(0rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 88rpx;
  background: rgba(20, 32, 56, 0.70);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 999;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  padding: 16rpx 0;
  position: relative;
}

.tab-highlight {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 184rpx;
  height: 80rpx;
  border-radius: 56rpx;
  transition: all 0.3s ease;
}

.tab-item.active .tab-highlight {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(16px) saturate(180%);
  -webkit-backdrop-filter: blur(16px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.30);
  box-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, 0.35), 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}
