/* Tab Bar 外层容器：固定定位 + 居中 */
.tab-bar-wrapper {
  position: fixed;
  bottom: 0;
  bottom: calc(0rpx + constant(safe-area-inset-bottom));
  bottom: calc(0rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 88rpx;
  z-index: 999;
}

/* Tab Bar 背后半透明阴影层 — 覆盖 tab bar 底部区域 */
.tab-bar-shadow {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 460rpx;
  height: 280rpx;
  background: rgba(0, 0, 0, 0.10);
  border-radius: 100rpx;
  filter: blur(50rpx);
  z-index: 0;
}

.tab-bar {
  position: relative;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 1;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  padding: 16rpx 0;
  position: relative;
}

.tab-highlight {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 184rpx;
  height: 80rpx;
  border-radius: 56rpx;
  transition: all 0.3s ease;
}

.tab-item.active .tab-highlight {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(16px) saturate(180%);
  -webkit-backdrop-filter: blur(16px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.30);
  box-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, 0.35), 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}
