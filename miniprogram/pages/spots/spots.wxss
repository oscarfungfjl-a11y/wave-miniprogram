/* ── 浪点列表页 v3 ── */

.search-bar {
  padding: 16rpx 24rpx;
  background: rgba(255,255,255,0.78);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border-bottom: 1rpx solid rgba(26,43,60,0.06);
}

.region-tabs {
  padding: 0 0 16rpx;
}

.region-scroll {
  display: flex;
  white-space: nowrap;
  padding: 0 24rpx;
}

.region-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #5A6B7C;
  background: rgba(255,255,255,0.65);
  border: 1rpx solid rgba(26,43,60,0.06);
  transition: all 0.2s ease;
}

.region-tag.active {
  color: #FFFFFF;
  font-weight: 500;
  background: #378ADD;
  border-color: #378ADD;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.spot-list {
  padding: 12rpx 24rpx 0;
}

.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
  gap: 12rpx;
}
