/**
 * 首页样式
 */
.header-banner {
  position: relative;
  background: linear-gradient(135deg, #0F6E56 0%, #1D9E75 100%);
  padding: 40rpx 32rpx 32rpx;
  overflow: hidden;
}

.header-content {
  position: relative;
  z-index: 1;
}

.greeting {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.date-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
}

.header-wave-decoration {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 20rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.15) 0%,
    rgba(255, 255, 255, 0.3) 25%,
    rgba(255, 255, 255, 0.15) 50%,
    rgba(255, 255, 255, 0.3) 75%,
    rgba(255, 255, 255, 0.15) 100%
  );
  border-radius: 0 0 50% 50%;
}

.section-title-wrap {
  display: flex;
  flex-direction: column;
}

.section-subtitle {
  margin-top: 4rpx;
}

.refresh-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(15, 110, 86, 0.06);
}

.recommend-list {
  padding: 0 24rpx;
}

.footer-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  gap: 8rpx;
}

.onboarding-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 48rpx 24rpx;
}
