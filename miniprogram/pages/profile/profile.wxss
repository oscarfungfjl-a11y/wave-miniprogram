.profile-card {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #0F6E56 0%, #1D9E75 100%);
  color: #FFFFFF;
}

.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.avatar-badge {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 4rpx 12rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 12rpx;
  white-space: nowrap;
}

.profile-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.nickname-input {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  width: 300rpx;
}

.edit-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-section {
  margin: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.logout-section {
  padding: 48rpx 24rpx;
}
