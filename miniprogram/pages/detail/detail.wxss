.spot-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #24292F;
  letter-spacing: -0.02em;
}

.spot-meta {
  margin-top: 8rpx;
}

/* 推荐摘要卡片 */
.rec-score-hero {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.rec-big-stars {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.04em;
}

.rec-star-label {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 12rpx;
  color: #59616B;
}

/* 四维数据卡片 */
.rec-dims {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.rec-dim {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  background: rgba(13,132,150,0.06);
  border-radius: 12rpx;
}

.rec-dim-label {
  display: block;
  font-size: 22rpx;
  color: #9BA5AF;
  margin-bottom: 4rpx;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.rec-dim-val {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0D8496;
}

.rec-best-hour {
  padding: 14rpx 0;
  text-align: center;
  color: #59616B;
}

/* 星级徽章 */
.star-badge {
  padding: 5rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  font-size: 24rpx;
  letter-spacing: 0.03em;
}

.star-bg-5 { background: #3D8B5E; color: #FFFFFF; }
.star-bg-4 { background: #0D8496; color: #FFFFFF; }
.star-bg-3 { background: #DC9018; color: #FFFFFF; }
.star-bg-2 { background: #E07B3B; color: #FFFFFF; }
.star-bg-1 { background: #CD4035; color: #FFFFFF; }

/* 文字色 */
.star-c-5 { color: #3D8B5E; }
.star-c-4 { color: #0D8496; }
.star-c-3 { color: #DC9018; }
.star-c-2 { color: #E07B3B; }
.star-c-1 { color: #CD4035; }

/* 小时预报表格 */
.h-table {
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255,255,255,0.78);
  border: 1px solid rgba(255,255,255,0.55);
  box-shadow: 0 4px 16px rgba(0,0,0,0.03);
}

.hourly-list {
  max-height: 560rpx;
  overflow-y: auto;
}

.h-thead {
  display: flex;
  align-items: center;
  padding: 16rpx 14rpx;
  background: rgba(13,132,150,0.06);
  border-bottom: 1px solid rgba(0,0,0,0.06);
}

.h-th {
  font-size: 22rpx;
  color: #9BA5AF;
  font-weight: 600;
  text-align: center;
  flex-shrink: 0;
  letter-spacing: 0.02em;
}

.h-tr {
  display: flex;
  align-items: center;
  padding: 18rpx 14rpx;
  border-bottom: 1px solid rgba(0,0,0,0.04);
}

.h-tr:nth-child(even) {
  background: rgba(13,132,150,0.02);
}

.h-td {
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 列宽 */
.h-th-time, .h-td-time {
  width: 76rpx;
  text-align: left;
  color: #9BA5AF;
  padding-left: 4rpx;
}

.h-th-wave, .h-td-wave {
  width: 84rpx;
  text-align: right;
  padding-right: 8rpx;
  font-weight: 600;
}

.h-th-per, .h-td-per {
  width: 72rpx;
  text-align: right;
  padding-right: 8rpx;
  color: #59616B;
}

.h-th-dir, .h-td-dir {
  width: 80rpx;
  text-align: center;
}

.h-th-temp, .h-td-temp {
  width: 72rpx;
  text-align: right;
  padding-right: 8rpx;
  color: #59616B;
}

.h-th-tide, .h-td-tide {
  width: 88rpx;
  text-align: right;
  padding-right: 8rpx;
  color: #59616B;
}

.h-th-pts, .h-td-pts {
  width: 56rpx;
  text-align: right;
  padding-right: 4rpx;
  font-weight: 600;
}

/* 评分颜色（按星级） */
.rec-score-s5 { color: #3D8B5E; }
.rec-score-s4 { color: #0D8496; }
.rec-score-s3 { color: #DC9018; }
.rec-score-s2 { color: #E07B3B; }
.rec-score-s1 { color: #CD4035; }

/* 未来天 */
.future-day-header {
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #E8F5F8, #D4EEF3);
  border-radius: 16rpx 16rpx 0 0;
  margin-top: 8rpx;
  font-weight: 600;
  color: #0D8496;
}
