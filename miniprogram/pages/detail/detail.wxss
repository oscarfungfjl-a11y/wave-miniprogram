/* ── 浪点详情页 v3 ── */

.spot-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #1A2B3C;
  letter-spacing: -0.01em;
}

.spot-meta {
  margin-top: 8rpx;
}

/* ── 推荐摘要卡片 ── */
.rec-score-hero {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.rec-big-stars {
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.08em;
  color: #1D9E75;
}

/* ── 半星图标容器 ── */
.stars-container {
  display: flex;
  gap: 8rpx;
  font-size: 36rpx;
  color: #1D9E75;
}

.star-item {
  position: relative;
  display: inline-block;
  width: 1em;
  height: 1em;
  line-height: 1;
}

.star-empty {
  position: absolute;
  left: 0;
  top: 0;
  line-height: 1;
  color: #D0D5DD;
}

.star-full-wrap {
  position: absolute;
  left: 0;
  top: 0;
  overflow: hidden;
  height: 100%;
}

.star-full {
  position: absolute;
  left: 0;
  top: 0;
  line-height: 1;
  color: #1D9E75;
}

.rec-star-label {
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 12rpx;
  color: #5A6B7C;
}

/* ── 四维数据卡片 ── */
.rec-dims {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.rec-dim {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  background: rgba(55,138,221,0.06);
  border-radius: 12rpx;
}

.rec-dim-label {
  display: block;
  font-size: 22rpx;
  color: #8A9BAC;
  margin-bottom: 4rpx;
  letter-spacing: 0.04em;
}

.rec-dim-val {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #378ADD;
}

.rec-best-hour {
  padding: 14rpx 0;
  text-align: center;
  color: #5A6B7C;
}

/* ── 星级徽章 ── */
/* 设计规范：底色12%透明度 + 深层文字色 */
.star-badge {
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
  font-size: 24rpx;
  letter-spacing: 0.03em;
}

.star-bg-5 { background: rgba(29,158,117,0.12); color: #0F6E56; }
.star-bg-4 { background: rgba(55,138,221,0.12); color: #1A5FB4; }
.star-bg-3 { background: rgba(186,117,23,0.12); color: #854F0B; }
.star-bg-2 { background: rgba(205,92,92,0.12); color: #8B2E2E; }
.star-bg-1 { background: rgba(136,135,128,0.12); color: #5F5E5A; }

/* ── 小时预报表格 ── */
.h-table {
  border-radius: 56rpx;
  overflow: hidden;
  background: rgba(255,255,255,0.78);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border: 1rpx solid rgba(255,255,255,0.6);
  box-shadow:
    0 8rpx 32rpx rgba(26,43,60,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.7);
}

.hourly-list {
  max-height: 560rpx;
  overflow-y: auto;
}

.h-thead {
  display: flex;
  align-items: center;
  padding: 16rpx 14rpx;
  background: rgba(55,138,221,0.06);
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
}

.h-th {
  font-size: 22rpx;
  color: #8A9BAC;
  font-weight: 500;
  text-align: center;
  flex-shrink: 0;
  letter-spacing: 0.02em;
}

.h-tr {
  display: flex;
  align-items: center;
  padding: 18rpx 14rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.h-tr:nth-child(even) {
  background: rgba(55,138,221,0.02);
}

.h-td {
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 列宽 */
.h-th-time, .h-td-time { width: 76rpx; text-align: left; color: #8A9BAC; padding-left: 4rpx; }
.h-th-wave, .h-td-wave { width: 84rpx; text-align: right; padding-right: 8rpx; font-weight: 500; }
.h-th-per, .h-td-per { width: 72rpx; text-align: right; padding-right: 8rpx; color: #5A6B7C; }

.h-th-wind, .h-td-wind { width: 72rpx; text-align: right; padding-right: 8rpx; color: #5A6B7C; }
.h-th-wind-speed, .h-td-wind-speed { width: 88rpx; text-align: right; padding-right: 8rpx; color: #5A6B7C; }
.h-th-tide, .h-td-tide { width: 88rpx; text-align: right; padding-right: 8rpx; color: #5A6B7C; }
.h-th-pts, .h-td-pts { width: 56rpx; text-align: right; padding-right: 4rpx; font-weight: 500; }

/* ── 评分颜色（按星级，统一绿色） ── */
.rec-score-s5 { color: #1D9E75; }
.rec-score-s4 { color: #1D9E75; }
.rec-score-s3 { color: #BA7517; }
.rec-score-s2 { color: #888780; }
.rec-score-s1 { color: #888780; }

/* ── 未来天 ── */
.future-day-header {
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #E6F1FB, #D4E6F8);
  border-radius: 16rpx 16rpx 0 0;
  margin-top: 8rpx;
  font-weight: 500;
  color: #378ADD;
}
