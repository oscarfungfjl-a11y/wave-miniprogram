<view class="page-container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="circular" size="48rpx" text="分析浪况中..." />
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{errorMsg}}" class="loading-wrap">
    <view style="text-align:center;padding:40rpx;">
      <text style="color:#CD4035;">{{errorMsg}}</text>
      <view style="margin-top:20rpx;">
        <t-button theme="primary" size="small" bindtap="onRetryLoad">重试</t-button>
      </view>
    </view>
  </view>

  <block wx:else>
    <!-- 综合建议推荐 -->
    <view class="advice-box">
      <text class="section-title" style="display:block;margin-bottom:16rpx;">冲浪建议</text>
      
      <!-- 今天冲浪建议 -->
      <view class="advice-section">
        <text class="advice-section-title">今天冲浪建议</text>
        <block wx:if="{{todayAdvice.hasRec}}">
          <view class="advice-rec-groups">
            <view class="advice-group-row" wx:for="{{todayAdvice.groups}}" wx:key="stars">
              <view class="advice-group-badge star-bg-{{item.starLevel}}">
                <text>{{item.starLabel}}</text>
                <text class="advice-badge-stars">{{item.stars}}★</text>
              </view>
              <view class="advice-group-names">
                <text class="advice-name-tag" wx:for="{{item.namesArr}}" wx:for-item="n" wx:key="*this">{{n}}</text>
              </view>
            </view>
          </view>
        </block>
        <text wx:else class="text-sm advice-empty">今天无推荐冲浪点</text>
      </view>

      <!-- 未来7天冲浪建议 -->
      <view class="advice-section">
        <text class="advice-section-title">未来7天最佳日期</text>
        <view class="week-chips">
          <view
            class="week-chip {{item.isRecommended ? 'week-chip-rec star-bg-' + item.starLevel : ''}} {{item.date === selectedDate && activeSource === 'week' ? 'week-chip-sel' : ''}}"
            wx:for="{{weekRecommendations}}"
            wx:key="date"
            bindtap="onWeekRecTap"
            data-date="{{item.date}}"
          >
            <text class="week-chip-weekday">{{item.weekday}}</text>
            <text class="week-chip-date">{{item.dateLabel}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 日期筛选 -->
    <view class="date-filter">
      <view class="date-chips">
        <view
          class="chip {{item.active ? 'chip-active' : ''}}"
          wx:for="{{dateChips}}"
          wx:key="label"
          data-index="{{index}}"
          bindtap="onTapChip"
        >{{item.label}}</view>
      </view>
      <view class="chip chip-picker" bindtap="onOpenCalendar">
        <text>📅</text>
      </view>
    </view>

    <!-- 日历弹窗 -->
    <view class="cal-overlay" wx:if="{{showCalendar}}" bindtap="onCloseCalendar">
      <view class="cal-popup" catchtap="">
        <view class="cal-hd">
          <text class="cal-arrow" bindtap="onPrevMonth">◀</text>
          <text class="cal-title">{{calYear}}年 {{calMonth + 1}}月</text>
          <text class="cal-arrow" bindtap="onNextMonth">▶</text>
        </view>
        <view class="cal-weekday-row">
          <text class="cal-wd" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="cal-grid">
          <view class="cal-row" wx:for="{{calMatrix}}" wx:key="index">
            <view
              class="cal-day {{cell ? '' : 'cal-empty'}} {{cell && cell.date === selectedDate && activeSource === 'calendar' ? 'cal-sel' : ''}} {{cell && cell.date < calMinDate ? 'cal-disabled' : ''}} {{cell && cell.date > calMaxDate ? 'cal-disabled' : ''}} {{cell && cell.isToday ? 'cal-today' : ''}}"
              wx:for="{{item}}" wx:for-item="cell" wx:key="index"
              data-date="{{cell ? cell.date : ''}}"
              bindtap="onTapCalDay"
            >
              <text wx:if="{{cell}}">{{cell.day}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 推荐浪点 -->
    <view wx:if="{{topSpots.length > 0}}">
      <!-- 标题栏 -->
      <view class="list-header">
        <view class="list-header-row">
          <view class="list-header-left">
            <text class="section-title">{{dateLabel}}推荐浪点</text>
            <view class="rule-btn" catchtap="onShowRules">
              <text class="rule-btn-text">?</text>
            </view>
          </view>
          <text class="list-header-update">更新于 {{lastUpdate}}</text>
        </view>
      </view>

      <!-- 浪点卡片 -->
      <view class="top-card" wx:for="{{topSpots}}" wx:key="spotId" bindtap="onTopSpotTap" data-spot-id="{{item.spotId}}">
        <view class="top-card-header" catchtap="onHeaderJump" data-cid="{{item.videoCid}}">
          <text class="top-spot-name">{{item.name}}</text>
          <text class="top-spot-area text-sm ml-12">（{{item.area}}）</text>
          <view class="star-badge star-bg-{{item.starLevel}} text-sm">
            {{item.starLabel}}
          </view>
        </view>
        <view class="top-card-body">
          <view class="top-score-row">
            <view class="stars-container">
              <view class="star-item" wx:for="{{[1,2,3,4,5]}}" wx:for-item="starIdx" wx:key="*this">
                <text class="star-empty">☆</text>
                <view class="star-full-wrap" style="width: {{item.starWidths[starIdx - 1]}};">
                  <text class="star-full">★</text>
                </view>
              </view>
            </view>
          </view>
          <view class="top-row">
            <view class="metric-col metric-col-wave">
              <text class="metric-label">浪高（m）</text>
              <text class="metric-val metric-val-wave">{{item.waveRangeVal}}</text>
            </view>
            <view class="metric-col metric-col-swell">
              <text class="metric-label">周期（s）</text>
              <text class="metric-val metric-val-swell">{{item.swellRangeVal}}</text>
            </view>
            <view class="metric-col metric-col-wind">
              <text class="metric-label">风速（km/h）</text>
              <text class="metric-val metric-val-wind">{{item.windSpeedRange}}</text>
            </view>
          </view>
          <view class="top-time">
            <text class="text-xs">最佳时段：{{item.timeRange}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:else>
      <t-empty icon="info-circle" description="暂未匹配到合适的推荐" />
    </view>
  </block>

  <view class="tab-bar-safe"></view>
</view>
