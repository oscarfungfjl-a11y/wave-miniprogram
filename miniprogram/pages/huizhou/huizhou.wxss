/* ── 日期筛选器 ── */
/* 设计规范：72rpx高、999rpx胶囊圆角、间距16rpx */
.date-filter {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.date-chips {
  display: flex;
  gap: 16rpx;
  flex: 1;
  overflow-x: auto;
}

.chip {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #5A6B7C;
  background: rgba(255,255,255,0.6);
  border: 1rpx solid rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  transition: all 0.2s ease;
}

.chip-active {
  color: #FFFFFF;
  font-weight: 500;
  background: #378ADD;
  border-color: #378ADD;
}

.chip-picker {
  width: 52rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 50%;
  font-size: 22rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 日历弹窗 ── */
.cal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-popup {
  width: 620rpx;
  background: rgba(255,255,255,0.78);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border-radius: 56rpx;
  padding: 32rpx 24rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,0.6);
  box-shadow:
    0 12rpx 48rpx rgba(0,0,0,0.14),
    inset 0 1rpx 0 rgba(255,255,255,0.7);
}

.cal-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1A2B3C;
}

.cal-arrow {
  font-size: 28rpx;
  color: #378ADD;
  padding: 8rpx 16rpx;
}

.cal-weekday-row {
  display: flex;
  margin-bottom: 12rpx;
}

.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #8A9BAC;
  font-weight: 500;
}

.cal-row { display: flex; }

.cal-day {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #1A2B3C;
  border-radius: 12rpx;
  margin: 2rpx;
}

.cal-empty { background: transparent; }

.cal-today {
  font-weight: 500;
  color: #378ADD;
}

.cal-sel {
  background: #378ADD;
  color: #FFFFFF;
  font-weight: 500;
}

.cal-disabled {
  color: #D0D5DD;
  pointer-events: none;
}

/* ── 综合建议 ── */
/* 设计规范：玻璃卡 + 56rpx圆角 */
.advice-box {
  margin: 0 24rpx 16rpx;
  padding: 36rpx 40rpx;
  border-radius: 56rpx;
  background: rgba(255,255,255,0.78);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border: 1rpx solid rgba(255,255,255,0.6);
  box-shadow:
    0 8rpx 32rpx rgba(26,43,60,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.7);
  line-height: 1.7;
}

.advice-box .text-sm {
  font-size: 24rpx;
  font-weight: 400;
  color: #5A6B7C;
}

.advice-section {
  margin-bottom: 24rpx;
}

.advice-section:last-child {
  margin-bottom: 0;
}

.advice-section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #378ADD;
  margin-bottom: 12rpx;
}

.advice-content {
  line-height: 1.7;
}

.week-recs {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.week-rec-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.5);
}

.week-rec-weekday {
  font-size: 26rpx;
  font-weight: 500;
  color: #1A2B3C;
  width: 80rpx;
}

.week-rec-date {
  font-size: 24rpx;
  color: #8A9BAC;
  flex: 1;
}

.week-rec-score {
  font-size: 26rpx;
  font-weight: 600;
  color: #378ADD;
}

.mb-12 { margin-bottom: 12rpx; }

/* ── 推荐浪点区域 ── */
.ml-12 { margin-left: 12rpx; }

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A2B3C;
  letter-spacing: -0.01em;
}

/* ── 第一张卡片顶部标题栏 ── */
.list-header {
  padding: 0 36rpx 16rpx;
}

.list-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-header-left {
  display: flex;
  align-items: center;
}

.rule-btn {
  margin-left: 12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #8A9BAC;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rule-btn-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #8A9BAC;
  line-height: 1;
}

.list-header-update {
  font-size: 22rpx;
  color: #8A9BAC;
}

/* ── 推荐浪点卡片 ── */
/* 设计规范：玻璃卡 + 56rpx圆角 + 细边框 */
.top-card {
  margin: 0 24rpx 24rpx;
  border-radius: 56rpx;
  background: rgba(255,255,255,0.78);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border: 1rpx solid rgba(255,255,255,0.6);
  box-shadow:
    0 8rpx 32rpx rgba(26,43,60,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.7);
  overflow: hidden;
}

.top-card-header {
  display: flex;
  align-items: center;
  padding: 36rpx 44rpx 12rpx;
}

.top-spot-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #1A2B3C;
}

.top-spot-area {
  font-size: 24rpx;
  color: #8A9BAC;
}

/* ── 推荐 tag ── */
/* 设计规范：底色12%透明度 + 深层文字色 */
.star-badge {
  margin-left: auto;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 500;
  font-size: 22rpx;
  letter-spacing: 0.03em;
}

/* 高推荐 (5★) → teal */
.star-bg-5 {
  background: rgba(29,158,117,0.12);
  color: #0F6E56;
}
/* 推荐 (4★) → teal */
.star-bg-4 {
  background: rgba(29,158,117,0.12);
  color: #0F6E56;
}
/* 中推荐 (3★) → amber */
.star-bg-3 {
  background: rgba(186,117,23,0.12);
  color: #854F0B;
}
/* 弱 (2★) → gray */
.star-bg-2 {
  background: rgba(136,135,128,0.12);
  color: #5F5E5A;
}
/* 弱 (1★) → gray */
.star-bg-1 {
  background: rgba(136,135,128,0.12);
  color: #5F5E5A;
}

/* ── 卡片 body ── */
.top-card-body {
  padding: 0 44rpx 36rpx;
}

/* ── 星级展示 ── */
/* 设计规范：绿色星 #1D9E75、36rpx、8rpx间距 */
.top-score-row {
  margin-bottom: 24rpx;
}

.top-big-stars {
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.08em;
  color: #1D9E75;
}

/* ── 三栏分列卡 metric-row ── */
/* 设计规范：32rpx圆角子卡、24rpx padding、40rpx/500数值 */
.top-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 0;
  background: none;
}

.metric-col {
  flex: 1;
  padding: 20rpx 12rpx;
  border-radius: 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.metric-col-wave {
  background: #E6F1FB;
}

.metric-col-swell {
  background: #E1F5EE;
}

.metric-col-tide {
  background: #EEEDFE;
}

.metric-label {
  font-size: 20rpx;
  font-weight: 400;
  color: #8A9BAC;
}

.metric-val {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.1;
}

.metric-val-wave { color: #378ADD; }
.metric-val-swell { color: #1D9E75; }
.metric-val-tide { color: #534AB7; }

/* ── 最佳时段 ── */
.top-time {
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.04);
}

.top-time .text-xs {
  font-size: 22rpx;
  font-weight: 500;
  color: #378ADD;
}

/* 旧有重复的工具类 (在全局已定义) — 兼容本地覆盖 */
.mt-8 { margin-top: 8rpx; }
