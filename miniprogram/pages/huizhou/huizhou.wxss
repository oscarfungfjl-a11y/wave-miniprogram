/* ── 日期筛选器 ── */
.date-filter {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.date-chips {
  display: flex;
  gap: 12rpx;
  flex: 1;
  overflow-x: auto;
}

.chip {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #59616B;
  background: rgba(255,255,255,0.72);
  border: 1px solid rgba(0,0,0,0.08);
  transition: all 0.2s ease;
}

.chip-active {
  color: #FFFFFF;
  background: #0D8496;
  border-color: #0D8496;
}

.chip-picker {
  width: 52rpx;
  height: 52rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* ── 日历弹窗 ── */
.cal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-popup {
  width: 620rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx 28rpx;
  box-shadow: 0 8px 40px rgba(0,0,0,0.12);
}

.cal-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #24292F;
}

.cal-arrow {
  font-size: 28rpx;
  color: #0D8496;
  padding: 8rpx 16rpx;
}

.cal-weekday-row {
  display: flex;
  margin-bottom: 12rpx;
}

.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #9BA5AF;
  font-weight: 600;
}

.cal-grid {}

.cal-row {
  display: flex;
}

.cal-day {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #24292F;
  border-radius: 12rpx;
  margin: 2rpx;
}

.cal-empty { background: transparent; }

.cal-today {
  font-weight: 700;
  color: #0D8496;
}

.cal-sel {
  background: #0D8496;
  color: #FFFFFF;
  font-weight: 700;
}

.cal-disabled {
  color: #DEE4EA;
  pointer-events: none;
}

/* 综合建议 */
.advice-box {
  padding: 24rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid #DC9018;
  line-height: 1.7;
  background: rgba(255,255,255,0.78);
  border: 1px solid rgba(255,255,255,0.55);
  box-shadow: 0 4px 16px rgba(0,0,0,0.03);
}

/* 推荐浪点卡片 */
.top-card {
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.82);
  border: 1px solid rgba(255,255,255,0.6);
  box-shadow: 0 4px 20px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.03);
  overflow: hidden;
}

.top-card-header {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #E8F5F8, #D4EEF3);
}

.top-spot-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #24292F;
}

.top-spot-area { color: #9BA5AF; }

.tier-badge {
  margin-left: auto;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
  font-size: 22rpx;
  letter-spacing: 0.03em;
}

.tier-high { background: #3D8B5E; color: #FFFFFF; }
.tier-mid  { background: #DC9018; color: #FFFFFF; }
.tier-low  { background: #CD4035; color: #FFFFFF; }

.top-card-body { padding: 18rpx 24rpx; }

.top-score-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.top-big-score {
  font-size: 52rpx;
  font-weight: 700;
  color: #DC9018;
  line-height: 1;
}

.top-dims { display: flex; gap: 8rpx; margin-bottom: 16rpx; }

.top-dim-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 4rpx;
  background: rgba(13,132,150,0.06);
  border-radius: 10rpx;
}

.top-dim-label { display: block; font-size: 20rpx; color: #9BA5AF; margin-bottom: 2rpx; }
.top-dim-val { display: block; font-size: 22rpx; font-weight: 600; color: #0D8496; }

.top-row { display: flex; align-items: center; gap: 8rpx; }
.top-label { font-size: 22rpx; color: #9BA5AF; min-width: 56rpx; }
.top-val { font-size: 24rpx; font-weight: 600; color: #24292F; margin-right: 16rpx; }

.top-time { margin-top: 14rpx; padding-top: 14rpx; border-top: 1px solid rgba(0,0,0,0.05); }

.rule-btn {
  margin-left: 12rpx;
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #0D8496;
  display: flex; align-items: center; justify-content: center;
}

.rule-btn-text { font-size: 22rpx; font-weight: 700; color: #0D8496; line-height: 1; }

.flex-row { display: flex; align-items: center; }
.mt-8 { margin-top: 8rpx; }
