.page-container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A2B3C;
  margin-bottom: 16rpx;
  display: block;
}

.card {
  padding: 28rpx;
  background: rgba(255,255,255,0.78);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border-radius: 56rpx;
  border: 1rpx solid rgba(255,255,255,0.6);
  box-shadow:
    0 8rpx 32rpx rgba(26,43,60,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.7);
}

.formula-box {
  padding: 24rpx;
  background: rgba(55,138,221,0.06);
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #378ADD;
}

.formula-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #378ADD;
  line-height: 1.8;
}

.tier-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.star-tier {
  font-size: 28rpx;
  font-weight: 500;
  margin-right: 12rpx;
  letter-spacing: 0.02em;
  min-width: 160rpx;
}

.star-tier-5 { color: #1D9E75; }
.star-tier-4 { color: #1D9E75; }
.star-tier-3 { color: #BA7517; }
.star-tier-2 { color: #888780; }
.star-tier-1 { color: #888780; }

.tier-desc {
  font-size: 26rpx;
  color: #5A6B7C;
}

.note-box {
  padding: 12rpx;
  background: rgba(55,138,221,0.04);
  border-radius: 8rpx;
}

.dim-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.dim-item:last-child { border-bottom: none; padding-bottom: 0; }

.dim-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A2B3C;
  margin-bottom: 8rpx;
  display: block;
}

.spot-rule-card {
  margin-bottom: 16rpx;
  border-radius: 56rpx;
  background: rgba(255,255,255,0.88);
  border: 1rpx solid rgba(55,138,221,0.12);
  box-shadow: 0 4rpx 24rpx rgba(26,43,60,0.05);
  overflow: hidden;
}

.spot-rule-header {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #E6F1FB, #D4E6F8);
}

.spot-rule-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #378ADD;
}

.spot-rule-area { color: #8A9BAC; }

.spot-rule-body { padding: 16rpx 20rpx; }

.info-row {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.info-row:last-child { border-bottom: none; }

.info-label {
  font-size: 24rpx;
  color: #8A9BAC;
  min-width: 120rpx;
  flex-shrink: 0;
}

.info-val {
  font-size: 24rpx;
  color: #1A2B3C;
  line-height: 1.5;
}

.text-xs { font-size: 22rpx; }
.text-sm { font-size: 24rpx; }
.text-secondary { color: #8A9BAC; }
.mt-16 { margin-top: 16rpx; }

/* ── 四维详解卡片增强 ── */
.dim-card { padding: 20rpx 24rpx; }

.dim-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.dim-badge {
  width: 72rpx;
  height: 36rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #FFFFFF;
  text-align: center;
  line-height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.dim-badge-dir { background: linear-gradient(135deg, #378ADD, #1A5FA8); }
.dim-badge-wave { background: linear-gradient(135deg, #1D9E75, #15785A); }
.dim-badge-swell { background: linear-gradient(135deg, #BA7517, #9E6412); }
.dim-badge-wind { background: linear-gradient(135deg, #8B5CF6, #7C3AED); }
.dim-badge-tide { background: linear-gradient(135deg, #534AB7, #4139A0); }

.dim-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1A2B3C;
}

.dim-desc {
  color: #5A6B7C;
  line-height: 1.7;
  display: block;
  margin-bottom: 6rpx;
}

.dim-detail {
  padding: 10rpx 14rpx;
  background: rgba(55,138,221,0.04);
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.dim-example-box {
  padding: 10rpx 14rpx;
  background: rgba(55,138,221,0.03);
  border-radius: 8rpx;
  margin-top: 6rpx;
}

.dim-example-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #378ADD;
  display: block;
  margin-bottom: 4rpx;
}

/* ── 权重设计逻辑 ── */
.weight-explain {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.weight-explain:last-child { border-bottom: none; }

/* ── 打分流程 ── */
.flow-step {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.flow-step:last-child { border-bottom: none; }

.flow-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #378ADD, #1A5FA8);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 500;
  text-align: center;
  line-height: 44rpx;
  flex-shrink: 0;
  margin-right: 14rpx;
}

.flow-body { flex: 1; padding-top: 2rpx; }

/* ── 数据来源与参考依据 ── */
.ref-subtitle {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A2B3C;
  margin-bottom: 16rpx;
  display: block;
}

.ref-body { color: #5A6B7C; line-height: 1.8; display: block; }
.ref-link { color: #378ADD; font-weight: 500; }
.ref-model-list { margin-top: 16rpx; }

.ref-model-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.ref-model-item:last-child { border-bottom: none; }

.ref-model-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1A2B3C;
  margin-bottom: 6rpx;
  display: block;
}

.ref-paper-list { margin-top: 8rpx; }

.ref-paper-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.ref-paper-item:last-child { border-bottom: none; }

.ref-paper-title {
  color: #1A2B3C;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.ref-source-list { margin-top: 12rpx; }

.ref-source-item {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.ref-source-item:last-child { border-bottom: none; }

.ref-bullet {
  font-size: 24rpx;
  color: #378ADD;
  margin-right: 10rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.ref-source-body { flex: 1; }

.ref-source-title {
  color: #1A2B3C;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}
