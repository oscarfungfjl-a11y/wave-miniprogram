.page-container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #24292F;
  margin-bottom: 16rpx;
  display: block;
}

.card {
  padding: 24rpx;
  background: rgba(255,255,255,0.78);
  border-radius: 16rpx;
  border: 1px solid rgba(255,255,255,0.55);
  box-shadow: 0 4px 16px rgba(0,0,0,0.03);
}

.formula-box {
  padding: 24rpx;
  background: rgba(13,132,150,0.06);
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #0D8496;
}

.formula-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #0D8496;
  line-height: 1.8;
}

.tier-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.tier-item {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.tier-high {
  background: #3D8B5E;
  color: #FFFFFF;
}

.tier-mid {
  background: #DC9018;
  color: #FFFFFF;
}

.tier-low {
  background: #CD4035;
  color: #FFFFFF;
}

.tier-desc {
  font-size: 26rpx;
  color: #59616B;
}

.note-box {
  padding: 12rpx;
  background: rgba(13,132,150,0.04);
  border-radius: 8rpx;
}

.dim-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.dim-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dim-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #24292F;
  margin-bottom: 8rpx;
  display: block;
}

.spot-rule-card {
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.78);
  border: 1px solid rgba(13,132,150,0.12);
  overflow: hidden;
}

.spot-rule-header {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #E8F5F8, #D4EEF3);
}

.spot-rule-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0D8496;
}

.spot-rule-area {
  color: #9BA5AF;
}

.spot-rule-body {
  padding: 16rpx 20rpx;
}

.info-row {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 24rpx;
  color: #9BA5AF;
  min-width: 120rpx;
  flex-shrink: 0;
}

.info-val {
  font-size: 24rpx;
  color: #24292F;
  line-height: 1.5;
}

.text-xs { font-size: 22rpx; }
.text-sm { font-size: 24rpx; }
.text-secondary { color: #9BA5AF; }
.mt-16 { margin-top: 16rpx; }
.tab-bar-safe { height: 80rpx; }
