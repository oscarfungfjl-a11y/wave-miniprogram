.page-container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C2C2A;
  margin-bottom: 16rpx;
  display: block;
}

.card {
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0,0,0,0.06);
}

.formula-box {
  padding: 24rpx;
  background: #F0F9F5;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #0F6E56;
}

.formula-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #0F6E56;
  line-height: 1.8;
}

.tier-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.tier-item {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.tier-high {
  background: #0F6E56;
  color: #FFFFFF;
}

.tier-mid {
  background: #EF9F27;
  color: #FFFFFF;
}

.tier-low {
  background: #E24B4A;
  color: #FFFFFF;
}

.tier-desc {
  font-size: 26rpx;
  color: #5F5E5A;
}

.note-box {
  padding: 12rpx;
  background: #F5F6F8;
  border-radius: 8rpx;
}

.dim-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.dim-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dim-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2A;
  margin-bottom: 8rpx;
  display: block;
}

.spot-rule-card {
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(15, 110, 86, 0.12);
  overflow: hidden;
}

.spot-rule-header {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #E1F5EE;
}

.spot-rule-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F6E56;
}

.spot-rule-area {
  color: #5F5E5A;
}

.spot-rule-body {
  padding: 16rpx 20rpx;
}

.info-row {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 24rpx;
  color: #888780;
  min-width: 120rpx;
  flex-shrink: 0;
}

.info-val {
  font-size: 24rpx;
  color: #2C2C2A;
  line-height: 1.5;
}

.mt-16 {
  margin-top: 16rpx;
}

.text-xs {
  font-size: 22rpx;
}

.text-sm {
  font-size: 24rpx;
}

.text-secondary {
  color: #5F5E5A;
}

.tab-bar-safe {
  height: 80rpx;
}
