/**
 * 浪报小程序 - 全局样式 v3
 * 设计系统：Liquid Glass / iOS 27 液态玻璃 / 海洋蓝
 * 品牌色：Ocean Blue #378ADD
 * 参考设计规范：design-spec.html
 */

/* TDesign 主题变量覆写 */
page {
  --td-brand-color: #378ADD;
  --td-brand-color-light: #E6F1FB;
  --td-brand-color-1: #E6F1FB;
  --td-brand-color-2: #C5DBF5;
  --td-brand-color-5: #378ADD;
  --td-brand-color-6: #1A5FA8;

  --td-font-size-body-medium: 28rpx;
  --td-font-size-title-medium: 32rpx;

  font-family: -apple-system, 'PingFang SC', 'SF Pro Text', BlinkMacSystemFont,
    'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #1A2B3C;
  background-color: #EFF5FC;
  line-height: 1.6;
}

/* 通用工具类 */
.page-container {
  min-height: 100vh;
  background-color: #EFF5FC;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.section {
  margin: 24rpx;
  padding: 28rpx;
  background: rgba(255,255,255,0.78);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border-radius: 56rpx;
  border: 1rpx solid rgba(255,255,255,0.6);
  box-shadow:
    0 8rpx 32rpx rgba(26,43,60,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.7);
}

/* 安卓 fallback：不支持 backdrop-filter 时增加不透明度 */
@supports not (backdrop-filter: blur(40px)) {
  .section {
    background: rgba(255,255,255,0.94);
  }
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A2B3C;
  letter-spacing: -0.01em;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* 文字颜色 — 设计稿色板 */
.text-primary {
  color: #378ADD;
}

.text-secondary {
  color: #8A9BAC;
}

.text-danger {
  color: #BA7517;
}

.text-xs { font-size: 22rpx; }
.text-sm { font-size: 24rpx; }
.text-md { font-size: 32rpx; }
.text-lg { font-size: 36rpx; }
.text-xl { font-size: 48rpx; }

/* 间距 */
.mt-8  { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8  { margin-bottom: 8rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-12 { margin-left: 12rpx; }
.mr-12 { margin-right: 12rpx; }
.mb-20 { margin-bottom: 20rpx; }

/* 底部安全区（考虑自定义 tabBar 高度） */
.tab-bar-safe {
  height: calc(136rpx + constant(safe-area-inset-bottom));
  height: calc(136rpx + env(safe-area-inset-bottom));
}

/* 加载/空状态居中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
