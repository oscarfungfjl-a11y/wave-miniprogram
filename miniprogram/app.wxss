/**
 * 浪报小程序 - 全局样式
 * 设计基调：海洋主题，清新自然
 */

/* TDesign 主题变量覆写 */
page {
  --td-brand-color: #0F6E56;
  --td-brand-color-light: #E1F5EE;
  --td-brand-color-1: #E1F5EE;
  --td-brand-color-2: #9FE1CB;
  --td-brand-color-5: #0F6E56;
  --td-brand-color-6: #085041;

  --td-font-size-body-medium: 28rpx;
  --td-font-size-title-medium: 32rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial,
    sans-serif;
  font-size: 28rpx;
  color: #2C2C2A;
  background-color: #F5F6F8;
  line-height: 1.6;
}

/* 通用工具类 */
.page-container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.section {
  margin: 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2A;
  margin-bottom: 24rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.text-primary {
  color: #0F6E56;
}

.text-secondary {
  color: #888780;
}

.text-danger {
  color: #D85A30;
}

.text-sm {
  font-size: 24rpx;
}

.text-lg {
  font-size: 36rpx;
}

.text-xl {
  font-size: 48rpx;
}

.mt-12 { margin-top: 12rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-12 { margin-left: 12rpx; }
.mr-12 { margin-right: 12rpx; }

/* 底部安全区（考虑自定义 tabBar 高度） */
.tab-bar-safe {
  height: calc(100rpx + constant(safe-area-inset-bottom));
  height: calc(100rpx + env(safe-area-inset-bottom));
}

/* 波浪装饰线（底部） */
.wave-divider {
  height: 4rpx;
  background: linear-gradient(90deg, #0F6E56 0%, #5DCAA5 50%, #0F6E56 100%);
  border-radius: 2rpx;
  margin: 16rpx 0;
}
