/**
 * 浪报小程序 - 全局样式 v2
 * 设计系统：Liquid Glass / 海洋数据终端
 * 品牌色：Ocean Teal #0D8496
 */

/* TDesign 主题变量覆写 */
page {
  --td-brand-color: #0D8496;
  --td-brand-color-light: #E8F5F8;
  --td-brand-color-1: #E8F5F8;
  --td-brand-color-2: #C4E8EF;
  --td-brand-color-5: #0D8496;
  --td-brand-color-6: #085560;

  --td-font-size-body-medium: 28rpx;
  --td-font-size-title-medium: 32rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text',
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue',
    Arial, sans-serif;
  font-size: 28rpx;
  color: #24292F;
  background-color: #F5F8FA;
  line-height: 1.6;
}

/* 通用工具类 */
.page-container {
  min-height: 100vh;
  background-color: #F5F8FA;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.section {
  margin: 24rpx;
  padding: 24rpx;
  background: rgba(255,255,255,0.78);
  border-radius: 24rpx;
  border: 1px solid rgba(255,255,255,0.55);
  box-shadow: 0 4px 20px rgba(0,0,0,0.03), 0 1px 3px rgba(0,0,0,0.02);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #24292F;
  letter-spacing: -0.01em;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* 文字颜色 — 设计稿色板 */
.text-primary {
  color: #0D8496;
}

.text-secondary {
  color: #9BA5AF;
}

.text-danger {
  color: #CD4035;
}

.text-sm {
  font-size: 24rpx;
}

.text-md {
  font-size: 32rpx;
}

.text-lg {
  font-size: 36rpx;
}

.text-xl {
  font-size: 48rpx;
}

/* 间距 */
.mt-8  { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8  { margin-bottom: 8rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-12 { margin-left: 12rpx; }
.mr-12 { margin-right: 12rpx; }

/* 底部安全区（考虑自定义 tabBar 高度） */
.tab-bar-safe {
  height: calc(100rpx + constant(safe-area-inset-bottom));
  height: calc(100rpx + env(safe-area-inset-bottom));
}

/* 波浪装饰线（底部） */
.wave-divider {
  height: 4rpx;
  background: linear-gradient(90deg, #0D8496 0%, #52BDD0 50%, #0D8496 100%);
  border-radius: 2rpx;
  margin: 16rpx 0;
}

/* 加载/空状态居中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
