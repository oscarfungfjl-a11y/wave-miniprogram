# 浪报小程序后端环境变量配置
# 复制此文件为 .env 即可直接使用

# 应用
DEBUG=true
SECRET_KEY=dev-secret-key-local-only

# 数据库 — 本地开发默认 SQLite（零依赖，开箱即用）
# 生产环境改为: postgresql+asyncpg://user:pass@host:5432/wave_report
DATABASE_URL=sqlite+aiosqlite:///./wave_report.db

# Redis — 本地开发可留空（缓存功能降级但不影响运行）
REDIS_URL=

# JWT
JWT_SECRET=dev-jwt-secret-local-only-md0a8s9d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# 微信小程序 — 本地开发可留空
WX_APPID=
WX_SECRET=

# Open-Meteo
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine

# 推荐引擎
REC_MAX_SPOTS=10
REC_CACHE_TTL_SECONDS=3600
